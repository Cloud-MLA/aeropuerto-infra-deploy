# Plantilla de variables de entorno. Copiar a .env (que NO se commitea).
# Ajustar según el microservicio.

# --- Común ---
PORT=8000                       # 8001 MS1 · 8002 MS2 · 8003 MS3 · 8004 MS4 · 8005 MS5
LOG_LEVEL=info
ENV=local                       # local | prod

# --- Base de datos (MS1 = MySQL, MS2 = PostgreSQL, MS3 = MongoDB) ---
DB_HOST=localhost
DB_PORT=3306                    # 3306 MySQL · 5432 PostgreSQL · 27017 MongoDB
DB_NAME=pasajeros
DB_USER=app
DB_PASSWORD=changeme
# Mongo (MS3): usar en su lugar
# MONGO_URI=mongodb://localhost:27017/infra

# --- Llamadas entre servicios (MS1, MS3, MS4) ---
MS1_BASE_URL=http://localhost:8001
MS2_BASE_URL=http://localhost:8002
MS3_BASE_URL=http://localhost:8003
HTTP_TIMEOUT_SECONDS=3
HTTP_RETRIES=2

# --- Athena / AWS (solo MS5; en EC2 usa el rol LabRole, no pongas claves) ---
AWS_REGION=us-east-1
ATHENA_DATABASE=aeropuerto_lake
ATHENA_OUTPUT=s3://mla-aeropuerto-lake/athena-results/
ATHENA_WORKGROUP=primary
