# Copiar a .env en cada VM-PROD (no se commitea).

# IP privada de la VM-DB (EC2 → la ves en la consola; se mantiene entre reinicios)
DB_HOST=10.0.10.XX

# Mismas contraseñas que pusiste en compose/vm-db/.env
MYSQL_ROOT_PASSWORD=pon-una-contrasena-larga
POSTGRES_PASSWORD=pon-otra-contrasena-larga

# Salida de Athena para MS5
ATHENA_OUTPUT=s3://mla-aeropuerto-lake/athena-results/

# Tags de imagen a desplegar (por defecto 'latest'); fijar a vX.Y para el Hito
TAG_MS1=latest
TAG_MS2=latest
TAG_MS3=latest
TAG_MS4=latest
TAG_MS5=latest
TAG_SWAGGER=latest
